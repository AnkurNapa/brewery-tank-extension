<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.disrupta.tableau.brewery-tank-monitor" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Brewery Tank Monitor — animated SVG fermentation tanks driven by a Tableau worksheet (TankName, Temperature, ABV, FillPercent, FermentationStage, BatchID, Status). Built with React + D3 + Tailwind.</description>
    <author name="Disruptive Advantage" email="ankur.napa@disruptive-advantage.com" organization="Disruptive Advantage" website="https://www.disruptive-advantage.com"/>
    <min-api-version>1.5</min-api-version>
    <source-location>
      <url>https://ankurnapa.github.io/brewery-tank-extension/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Brewery Tank Monitor</text>
    </resource>
  </resources>
</manifest>
